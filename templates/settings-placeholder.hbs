<div class="astralforge-bounty-settings">
  <header class="afbb-header">
    <div class="afbb-title">AstralForge Bounty Board Settings</div>
    <div class="afbb-subtitle">
      Configure global behavior for bounty boards and quest generation.
    </div>
  </header>

  <section class="afbb-settings-section">
    <h2>General</h2>

    <div class="form-group">
      <label>
        <input type="checkbox" name="autoSeed" {{#if autoSeed}}checked{{/if}} />
        Auto-seed default quests on world load
      </label>
      <p class="notes">
        If enabled, the module will populate starter quests when the board is empty.
      </p>
    </div>

    <div class="form-group">
      <label>
        <input type="checkbox" name="allowPlayerAccept" {{#if allowPlayerAccept}}checked{{/if}} />
        Allow players to accept quests
      </label>
      <p class="notes">
        Disable this to require the GM to assign or accept quests manually.
      </p>
    </div>
  </section>

  <section class="afbb-settings-section">
    <h2>Quest Behavior</h2>

    <div class="form-group">
      <label for="afbb-expiration-days">Default Expiration (Days)</label>
      <input
        id="afbb-expiration-days"
        type="number"
        name="expirationDays"
        min="0"
        step="1"
        value="{{expirationDays}}"
      />
      <p class="notes">
        How long available quests remain active before expiring. Set to 0 to disable automatic expiration.
      </p>
    </div>

    <div class="form-group">
      <label for="afbb-max-quests">Max Active Quests</label>
      <input
        id="afbb-max-quests"
        type="number"
        name="maxQuests"
        min="0"
        step="1"
        value="{{maxQuests}}"
      />
      <p class="notes">
        Limits how many quests can exist at once. Set to 0 for no limit.
      </p>
    </div>
  </section>

  <section class="afbb-settings-section">
    <h2>Debug</h2>

    <div class="form-group">
      <label>
        <input type="checkbox" name="debugMode" {{#if debugMode}}checked{{/if}} />
        Enable debug logging
      </label>
      <p class="notes">
        Outputs extra diagnostic messages to the browser console for troubleshooting.
      </p>
    </div>
  </section>

  <footer class="afbb-settings-footer">
    <button type="button" data-action="save-settings">
      <i class="fas fa-save"></i> Save Settings
    </button>
  </footer>
</div>